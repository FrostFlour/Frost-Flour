# Dependencies
node_modules/

# Secrets (database URL, passwords): never commit these
# Ignores every .env file (nodejs/.env, nodejs/.env.atlas, ...) in any folder,
# except the safe ones listed with "!" below.
.env
.env.*
*.local
!.env.example
!react/.env.development
!react/.env.production

# Logs
logs/*.log
npm-debug.log*

# Build output
dist/

# Uploaded files (keep the folder, not the images)
nodejs/uploads/products/*
!nodejs/uploads/products/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
# Office temporary lock files (created while a document is open)
~$*
.idea/
