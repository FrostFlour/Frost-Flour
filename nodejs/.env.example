PORT=3000

# Copy this file to .env and paste your own Atlas connection string.
# The string MUST end with a database name before the "?", like:
#   ...mongodb.net/frostflour?retryWrites=true&w=majority
# Without it, mongoose uses a default database called "test".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/frostflour?retryWrites=true&w=majority

CORS_ORIGINS=http://localhost:5173,https://frostflour.github.io
